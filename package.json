{
  "name": "car-hunter",
  "version": "0.1.0",
  "private": true,
  "description": "CarHunter — AI agent pro hledání ojetého auta. Monorepo: landing page + produkt.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:landing": "pnpm --filter @car-hunter/landing dev",
    "dev:app": "pnpm --filter @car-hunter/app dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  }
}
